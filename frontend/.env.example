# Frontend / .env.example
# -----------------------
# Create a file named `.env` in the PROJECT ROOT (frontend/.env — not src/)
# and fill in real values. Create React App only auto-loads env files from
# the project root, and only variables prefixed with `REACT_APP_` are exposed
# to the browser at build time.
#
# `.env` is gitignored, so nothing here is committed. The values below are
# the local-dev defaults; only override what differs.

# Backend API base URL (no trailing slash)
REACT_APP_API_URL=http://localhost:5000

# Cloudinary uploads (profile photos / resume PDFs)
# Optional for local demos — uploads throw a clear error if left unset.
REACT_APP_CLOUDINARY_CLOUD_NAME=your-cloud-name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset