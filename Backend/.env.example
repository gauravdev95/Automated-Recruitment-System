# Backend / .env.example
# -----------------------
# Copy this file to `.env` and fill in real values before running the server.
# The backend validates its env config on startup (src/config/env.config.js)
# and exits if any required value is missing.
#
# Note: the .gitignore ignores `.env` and `.env.*`, so secrets never get
# committed. `.env.example` is intentionally safe (placeholder values only).

# Server
PORT=5000
NODE_ENV=development

# MongoDB — required (note: MONGO_URL, not MONGO_URI)
MONGO_URL=mongodb://127.0.0.1:27017/talentforge

# Auth — both secrets must be at least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
TEST_SECRET=change-me-to-a-different-random-string-of-at-least-32-chars

# Judge0 code-execution API (https://www.judge0.com/)
JUDGE0_URL=http://localhost:2358
JUDGE0_HOST=rapidapi.judge0.com
JUDGE0_KEY=your-judge0-rapidapi-key

# SMTP / email — used for test + interview invitation emails
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend / app URLs
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5000

# AI resume-scoring service (optional; defaults to http://127.0.0.1:8000)
ML_API_URL=http://127.0.0.1:8000